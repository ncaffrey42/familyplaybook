# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.
#
# Used by both workflows:
#   Local dev  →  npm run dev            (Vite reads .env.local automatically)
#   Docker dev →  docker compose -f docker-compose.dev.yml up
#   Docker prod→  docker compose up --build  (values are baked into the build)

# -------------------------------------------------------
# Supabase
# Found in: Supabase dashboard > Project Settings > API
# -------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -------------------------------------------------------
# App URL
# Local dev:   http://localhost:3000
# Docker dev:  http://localhost:3000
# Production:  https://your-domain.com   ← update before a production build
# Used for auth redirects and share-link generation.
# -------------------------------------------------------
VITE_APP_URL=http://localhost:3000

# -------------------------------------------------------
# Stripe (public/publishable key only — used client-side)
# Secret key lives in Supabase edge function secrets, NOT here.
# Found in: Stripe dashboard > Developers > API Keys
# Leave blank to disable Stripe UI in local dev.
# -------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# -------------------------------------------------------
# Feature flags
# Set to true to enable AI guide-generation features.
# Requires OPENAI_API_KEY to be set as a Supabase edge function secret.
# Defaults to false in Docker production builds if not set.
# -------------------------------------------------------
VITE_ENABLE_AI_GENERATION=false

# Family/friends invites: invited members see the owner's guides and
# bundles ("Shared" badge); editors can edit them, viewers are read-only.
# Requires migration 20240110_family_member_access to be applied.
VITE_ENABLE_FAMILY_SHARING=true

# "Manage" entry point in the Share tab's "Family & helpers" header,
# opening the existing /account/family screen (also in Settings). The
# Share tab already lists members and manages what each can see — this
# makes inviting/removing discoverable from the same place. Ships dark;
# has no effect unless VITE_ENABLE_FAMILY_SHARING is also on.
# See docs/platform/NAV.md.
VITE_ENABLE_SHARE_TAB_MANAGE=false

# -------------------------------------------------------
# Native In-App Purchase (RevenueCat) — mobile apps only
# Leave OFF for web/Docker. Turn on in the native build once RevenueCat
# products + webhook are configured (see REVENUECAT_SETUP.md).
# iOS/Android forbid Stripe for in-app subscriptions; native apps use
# store billing via RevenueCat, reconciled into user_billing by the
# revenuecat-webhook edge function.
# -------------------------------------------------------
VITE_ENABLE_IAP=false
# Public SDK keys from the RevenueCat dashboard (Project > API keys):
VITE_REVENUECAT_IOS_KEY=appl_your-ios-sdk-key
VITE_REVENUECAT_ANDROID_KEY=goog_your-android-sdk-key

# -------------------------------------------------------
# Supabase Edge Function Secrets  (set via: supabase secrets set)
# These are NOT prefixed with VITE_ — they are server-only and
# must never appear in this file or be committed to the repo.
# Run: supabase secrets set STRIPE_SECRET_KEY=sk_test_... etc.
# -------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_your-secret-key-here
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_your-signing-secret-here
# STRIPE_PRICE_COUPLE_MONTH=price_...
# STRIPE_PRICE_COUPLE_YEAR=price_...
#
# RevenueCat (native IAP) edge-function secrets:
# REVENUECAT_WEBHOOK_AUTH=<shared secret; matches RevenueCat's Authorization header>
# RC_PRODUCT_COUPLE_MONTH=fp_couple_monthly   # store product id -> plan_key
# RC_PRODUCT_COUPLE_YEAR=fp_couple_yearly
# RC_PRODUCT_FAMILY_MONTH=fp_family_monthly
# RC_PRODUCT_FAMILY_YEAR=fp_family_yearly
# STRIPE_PRICE_FAMILY_MONTH=price_...
# STRIPE_PRICE_FAMILY_YEAR=price_...
# OPENAI_API_KEY=sk-...
# APP_URL=https://your-domain.com

# -------------------------------------------------------
# In-app feedback (bubble + checkpoint prompts)
# On by default; set false to hide entirely.
# -------------------------------------------------------
VITE_ENABLE_FEEDBACK=true
# App Store numeric id (from App Store Connect, once the listing exists).
# The "leave a review" ask stays hidden on iOS until this is set.
VITE_APPSTORE_ID=

# Feedback fan-out (edge-function secrets — supabase secrets set):
# FEEDBACK_SHEETS_URL=      # Google Apps Script web-app URL (see FEEDBACK_SETUP.md)
# FEEDBACK_SLACK_WEBHOOK=   # Slack incoming-webhook URL
# RESEND_API_KEY=           # Resend key for email delivery
# FEEDBACK_EMAIL_TO=        # where feedback emails go
# FEEDBACK_EMAIL_FROM=      # optional verified sender
