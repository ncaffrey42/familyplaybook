# Copy to .env (same folder) and fill in. .env is gitignored — keys never get committed.

# Timezone (affects scheduled sync times)
TZ=America/New_York

# File permissions — on Docker Desktop (Windows/macOS) the defaults are fine.
PUID=1000
PGID=1000

# Media folders on the HOST, exactly the ones Radarr/Sonarr manage.
# Windows Docker Desktop example:  C:\Media\Movies  ->  MOVIES_PATH=C:\Media\Movies
MOVIES_PATH=/path/to/movies
TV_PATH=/path/to/tv

# Radarr / Sonarr — host.docker.internal reaches services running on the
# Docker Desktop host machine. If Radarr/Sonarr run in another compose stack,
# these defaults work as long as their ports are published.
RADARR_BASE_URL=http://host.docker.internal:7878
RADARR_API_KEY=paste-from-radarr-settings-general
SONARR_BASE_URL=http://host.docker.internal:8989
SONARR_API_KEY=paste-from-sonarr-settings-general

# For scripts/scan_missing_subs.py only (not used by the containers)
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=see-MEDIA_SETUP.md-for-how-to-find-this
