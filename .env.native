# Native (Capacitor) build environment — loaded by `vite build --mode native`
# (npm run build:native / mobile:sync). Overrides .env.local for that mode;
# the web/Docker build never reads this file. Nothing here is secret: the
# anon key is public by design and ships in every bundle.
VITE_SUPABASE_URL=https://ifdncylgiqhhcwovpdyf.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlmZG5jeWxnaXFoaGN3b3ZwZHlmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjAxOTYwMTgsImV4cCI6MjA3NTc3MjAxOH0.hktyIYDMZQAUY1jycUN6OCII9ThDIXnREgnPuSnDHvw

# Public web app URL. Share links and invites created inside the native app
# point here (src/lib/publicUrl.js) — the WebView's own origin is unreachable.
# The web app must be deployed at this address for recipients to open links.
VITE_APP_URL=https://app.famplaybook.com

VITE_ENABLE_AI_GENERATION=true
VITE_ENABLE_FAMILY_SHARING=true
VITE_ENABLE_FEEDBACK=true

# Store billing stays OFF until RevenueCat + Play subscriptions exist
# (REVENUECAT_SETUP.md). While off, native builds show no purchase UI at all.
VITE_ENABLE_IAP=false
