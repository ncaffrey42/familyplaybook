# Copy to .env.fastlane and fill in once your accounts exist. This file is
# gitignored — never commit real values. Fastlane auto-loads .env.fastlane when
# you run `fastlane ... --env fastlane`, or `source` it before running.

# ── Apple ─────────────────────────────────────────────────────────────────────
FASTLANE_APPLE_ID="support@famplaybook.com"
FASTLANE_TEAM_ID="XXXXXXXXXX"            # Apple Developer > Membership > Team ID

# App Store Connect API key (App Store Connect > Users and Access > Integrations
# > App Store Connect API > generate a key with "App Manager" access).
ASC_KEY_ID="XXXXXXXXXX"                  # the key's Key ID
ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx"  # the Issuer ID (top of that page)
ASC_KEY_PATH="./fastlane/AuthKey_XXXXXXXXXX.p8"   # the downloaded .p8 (keep it OUT of git)

# ── Google Play (later) ───────────────────────────────────────────────────────
SUPPLY_JSON_KEY="./fastlane/play-service-account.json"
