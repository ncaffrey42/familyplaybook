# Copy to android/keystore.properties and fill in. That file is gitignored and
# must NEVER be committed — it holds the upload key's passwords.
#
# Create the keystore first (run this yourself; choose a strong password and
# store it in your password manager, not here in plaintext anywhere else):
#
#   keytool -genkeypair -v \
#     -keystore ~/familyplaybook-upload.jks \
#     -alias familyplaybook-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep ~/familyplaybook-upload.jks OUTSIDE this repo and back it up somewhere
# durable. If it is lost, this app can never be updated on Play again — the
# only recovery is Google's upload-key reset, which requires Play App Signing
# to have been enrolled.
#
# storeFile is resolved relative to the android/ directory, so an absolute
# path outside the repo is the safest choice.

storeFile=/Users/YOU/familyplaybook-upload.jks
storePassword=CHANGEME
keyAlias=familyplaybook-upload
keyPassword=CHANGEME
