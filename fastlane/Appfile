# Fastlane app configuration.
# Secrets come from environment variables (see .env.fastlane.example) so nothing
# sensitive is committed. Fill these in once your Apple Developer account and
# App Store Connect API key exist.

app_identifier("com.familyplaybook.app")            # the app's bundle id
apple_id(ENV["FASTLANE_APPLE_ID"])                  # e.g. support@famplaybook.com
team_id(ENV["FASTLANE_TEAM_ID"])                    # Apple Developer > Membership > Team ID

# ── Android (Google Play) ─────────────────────────────────────────────────────
for_platform :android do
  package_name("com.famplaybook.app")
  json_key_file(ENV["SUPPLY_JSON_KEY"])             # Play Console service-account JSON
end
