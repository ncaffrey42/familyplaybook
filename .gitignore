# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment variables — never commit these
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite cache
.vite/

# Claude Code local state (worktrees, session settings)
.claude/

# Supabase CLI local state
supabase/.temp/

# TypeScript
*.tsbuildinfo

# Capacitor native build artifacts (the ios/ and android/ projects themselves
# are committed after `npm run mobile:add`, but their build output is not)
ios/App/Pods/
ios/App/App/public/
ios/DerivedData/
android/.gradle/
android/app/build/
android/build/
*.xcuserstate

# Fastlane secrets + artifacts
.env.fastlane
fastlane/*.p8
fastlane/*.json
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
build/ios/
*.ipa
*.dSYM.zip

# Test coverage output (scripts/audit.mjs)
coverage/

# Android release signing — the upload key and its passwords. Committing any
# of these would hand anyone the ability to publish as this app.
android/keystore.properties
*.jks
*.keystore
